<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="016-membership-features" author="gemini">
        <createTable tableName="membership_features" schemaName="public">
            <column name="membership_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_mem_feat_membership" references="public.memberships(id)"/>
            </column>
            <column name="feature" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Migrar permisos base para los empleados existentes (si los hay) -->
        <sql>
            INSERT INTO public.membership_features (membership_id, feature)
            SELECT m.id, 'POS' FROM public.memberships m WHERE m.role IN ('EMPLOYEE', 'ADMIN');
            
            INSERT INTO public.membership_features (membership_id, feature)
            SELECT m.id, 'INVENTORY' FROM public.memberships m WHERE m.role IN ('EMPLOYEE', 'ADMIN');
        </sql>
    </changeSet>

</databaseChangeLog>
