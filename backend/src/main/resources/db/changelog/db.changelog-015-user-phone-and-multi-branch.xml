<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="015-user-phone-and-multi-branch" author="gemini">
        <!-- Add phone number to users -->
        <addColumn tableName="users" schemaName="public">
            <column name="phone_number" type="varchar(50)"/>
        </addColumn>

        <!-- Create table for multiple branches per membership -->
        <createTable tableName="membership_branches" schemaName="public">
            <column name="membership_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_mem_branch_membership" references="public.memberships(id)"/>
            </column>
            <column name="branch_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Migrate existing single branch_id to the new table -->
        <sql>
            INSERT INTO public.membership_branches (membership_id, branch_id)
            SELECT id, branch_id FROM public.memberships WHERE branch_id IS NOT NULL;
        </sql>

        <!-- Drop old single branch_id column -->
        <dropColumn tableName="memberships" schemaName="public" columnName="branch_id"/>
    </changeSet>

</databaseChangeLog>
